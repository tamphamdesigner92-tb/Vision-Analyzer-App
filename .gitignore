# Môi trường ảo Python (nặng, cài lại bằng requirements.txt)
.venv/
# venv thu hai cua sidecar nhung - cai lai bang setup_embedding_sidecar.bat
.venv-embed/
venv/
__pycache__/
*.pyc
*.egg-info/

# Anh/video nguoi dung dua vao de phan tich - khong phai code, co the rat nang
media_input/*
!media_input/.gitkeep

# Ket qua phan tich + database lich su - sinh ra tu code, khong can luu tren git
vision_storage/*
!vision_storage/.gitkeep

# Log va file tam sinh ra khi debug/test
*.log
bat_out.txt
vram_samples.txt

# Trang thai runtime cua Claude Code (khac voi launch.json la cau hinh du an nen giu lai)
.claude/scheduled_tasks.lock

# Rac he dieu hanh
Thumbs.db
.DS_Store

# Phim dai: model/cong cu tai ve + du lieu du an (nam o thu muc nguoi dung chon)
models/
tools/llama.cpp/
projects/
projects.json
settings.json
.ram_profile.json
